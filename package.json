{
  "name": "melnycz.uk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "keywords": [
    "artist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/components": "./src/lib/components/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "serve": "vite preview --port 3000",
    "images": "node scripts/fetchImageData.cjs"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "marked": "^18.1.1",
    "modern-css-reset": "^1.4.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "@types/rss": "^0.0.32",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "follow-redirects": "^1.16.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "imagemagick": "^0.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
